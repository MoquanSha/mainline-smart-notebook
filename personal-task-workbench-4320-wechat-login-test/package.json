{
  "name": "mainline-smart-notebook",
  "version": "1.1.63-reliability.3",
  "private": true,
  "description": "A local, self-following work notebook that turns text and Codex conversations into a daily record and realistic plan.",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.mjs",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win nsis",
    "test": "node --test tests/reliability-*.test.* tests/attachment-environment-repair.test.cjs tests/rollover-cross-device-dedup.test.mjs tests/wechat-login-flow.test.cjs",
    "test:live-qr": "node --test tests/rendered-wechat-login.test.cjs",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.7.1",
    "@fontsource-variable/inter": "5.2.8",
    "@phosphor-icons/react": "2.1.10",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "playwright": "^1.61.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "8.1.5"
  },
  "type": "module",
  "build": {
    "compression": "normal",
    "appId": "com.shamoquan.mainline-smart-notebook.reliability-test",
    "productName": "主线笔记可靠性测试版",
    "asar": false,
    "directories": {
      "output": "release-1.1.63-reliability.3"
    },
    "files": [
      "dist/**/*",
      "server.mjs",
      "home-sync.mjs",
      "home-history.mjs",
      "local-recovery.mjs",
      "relay/home-forwarding.cjs",
      "shared/**/*",
      "ai/**/*",
      "hooks/**/*",
      "public/favicon.svg",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
