@import "./diary-markdown.wxss";
.diary-page{padding-top:36rpx;background:linear-gradient(180deg,#fbfbff 0,#fff 460rpx)}.diary-header{align-items:flex-start}.diary-refresh{max-width:176rpx;padding:0 14rpx;white-space:nowrap}.diary-lead-card,.diary-section-card,.diary-fold-card{box-sizing:border-box;margin-top:24rpx;padding:25rpx;border:1rpx solid #e4e6ed;border-radius:20rpx;background:rgba(255,255,255,.96);box-shadow:0 10rpx 30rpx rgba(52,58,91,.045)}.diary-lead-card{border-color:#dcdff1;background:linear-gradient(145deg,#fff 0,#f5f6ff 100%)}.diary-card-head,.diary-section-head,.period-top,.change-row,.fold-row,.history-date,.todo-note-top,.legacy-actions{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.diary-card-head{align-items:flex-start}.diary-card-title,.diary-section-title,.fold-title{color:#171820;font-size:28rpx;font-weight:730}.diary-save-state{color:#8b8f9a;text-align:right;font-size:18rpx;line-height:1.45}.diary-summary{margin-top:20rpx;color:#30323b;font-size:27rpx;line-height:1.72}.diary-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8rpx;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #e6e8f0}.diary-stat{text-align:center}.diary-stat text{display:block;color:#5367d9;font-size:34rpx;font-weight:750}.diary-stat view{margin-top:3rpx;color:#8a8e99;font-size:17rpx}.diary-section-head{margin-bottom:18rpx}.diary-section-head>view:last-child{color:#8a8e99;font-size:20rpx}.diary-empty,.change-empty{padding:16rpx 0;color:#9a9da7;font-size:22rpx;line-height:1.55}.diary-period{display:flex;gap:16rpx;padding:16rpx 0;border-top:1rpx solid #eef0f4}.diary-period:first-of-type{border-top:0}.period-rail{width:7rpx;align-self:stretch;border-radius:10rpx;background:#5b70df}.period-in_progress .period-rail{background:#d08b3c}.period-blocked .period-rail{background:#b45a5a}.period-body{min-width:0;flex:1}.period-title{min-width:0;flex:1;color:#252730;font-size:25rpx;font-weight:690}.period-status{color:#6874b4;font-size:18rpx}.period-time{margin-top:5rpx;color:#9295a0;font-size:18rpx}.period-summary,.period-outcomes{margin-top:8rpx;color:#5a5d67;font-size:22rpx;line-height:1.55}.period-outcomes{color:#3f424b}.change-group{padding:18rpx 0;border-top:1rpx solid #eef0f4}.change-group:first-of-type{border-top:0}.change-label{margin-bottom:10rpx;color:#5367d9;font-size:20rpx;font-weight:680}.change-row{align-items:flex-start;padding:8rpx 0;color:#3f424c;font-size:23rpx;line-height:1.5}.change-row text:first-child{min-width:0;flex:1}.change-row text:last-child{color:#9699a3;font-size:19rpx}.fold-row{min-height:62rpx;color:#555965;font-size:22rpx}.fold-row>view:last-child{color:#6a76c1}.main-fold>view:first-child{display:flex;min-width:0;flex:1;flex-direction:column;gap:5rpx}.fold-count{color:#9498a3;font-size:18rpx;font-weight:400}.todo-note-list{padding-top:10rpx;border-top:1rpx solid #eef0f4}.todo-note-row{margin-top:10rpx;padding:15rpx;border-radius:13rpx;background:#f7f8fb;color:#555963;font-size:21rpx;line-height:1.55}.todo-note-top{margin-bottom:7rpx;color:#343741;font-weight:650}.todo-note-top text:last-child{color:#9699a3;font-size:18rpx;font-weight:400}.diary-history-scroll{height:680rpx;margin-top:12rpx;overscroll-behavior:contain}.history-day{padding:20rpx 0;border-top:1rpx solid #eceef3}.history-date>view{display:flex;align-items:center;gap:10rpx}.history-date>view text:first-child{color:#262832;font-size:24rpx;font-weight:690}.history-date>view text:last-child,.history-date>text{color:#9699a3;font-size:18rpx}.history-summary{margin-top:10rpx;color:#555863;font-size:22rpx;line-height:1.62}.legacy-card{margin-bottom:20rpx}.legacy-content{padding-top:18rpx;border-top:1rpx solid #eceef3}.legacy-actions{justify-content:flex-end}.tasks-page{padding-top:36rpx}.task-toolbar{margin-top:22rpx}.search{box-sizing:border-box;width:100%;height:70rpx;padding:0 21rpx;border:1rpx solid #dfe1e7;border-radius:13rpx;background:#fafbfc;color:#171820;font-size:24rpx}.owner-tabs{display:flex;gap:5rpx;margin-top:12rpx;padding:5rpx;border-radius:13rpx;background:#f3f4f6}.owner-tab{min-width:0;flex:1;padding:12rpx 4rpx;border-radius:9rpx;color:#747782;text-align:center;font-size:20rpx}.owner-tab.active{background:#fff;color:#171820;font-weight:680;box-shadow:0 1rpx 4rpx rgba(23,24,32,.07)}.list-heading,.task-topline,.current-step,.progress-row,.task-meta,.task-actions,.step-meta,.completed-toggle{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.list-heading{margin:34rpx 2rpx 15rpx;color:#171820;font-size:27rpx;font-weight:710}.list-heading view:last-child{color:#8a8e99;font-size:21rpx}.task-card,.completed-card{margin-bottom:12rpx;padding:22rpx;border:1rpx solid #e5e7eb;border-left:5rpx solid #5367d9;border-radius:16rpx;background:#fff}.task-card.owner-border-ai{border-left-color:#7157b8}.task-card.owner-border-both{border-left-color:#287d78}.task-title{min-width:0;flex:1;color:#171820;font-size:29rpx;font-weight:710;line-height:1.4}.description{display:-webkit-box;overflow:hidden;margin-top:10rpx;color:#60636e;font-size:23rpx;line-height:1.5;-webkit-box-orient:vertical;-webkit-line-clamp:2}.next-action{margin-top:15rpx;color:#252832;font-size:24rpx;font-weight:650;line-height:1.5}.next-action text{margin-right:10rpx;color:#5367d9;font-size:21rpx}.current-step{align-items:flex-end;margin-top:15rpx;padding:14rpx;border-radius:12rpx;background:#f7f8fa}.current-step>view{min-width:0;flex:1}.current-label{margin-bottom:4rpx;color:#5367d9;font-size:19rpx;font-weight:650}.current-title{color:#3f424c;font-size:22rpx;line-height:1.45}.complete-step{width:auto;height:52rpx;margin:0;padding:0 13rpx;border-radius:10rpx;background:#eaf6f0;color:#287459;font-size:20rpx;font-weight:650;line-height:52rpx}.step-meta{margin-top:14rpx;color:#747782;font-size:21rpx}.step-list{margin-top:11rpx;padding:8rpx 0;border-top:1rpx solid #eceef2}.step-row{display:flex;align-items:flex-start;gap:12rpx;padding:8rpx 2rpx;color:#535660;font-size:22rpx;line-height:1.45}.step-marker{width:10rpx;height:10rpx;margin-top:10rpx;border-radius:50%;background:#c8cbd3}.step-done{color:#989ba5;text-decoration:line-through}.step-current .step-marker{background:#5367d9}.progress-row{margin-top:15rpx}.progress-slider{min-width:0;flex:1;margin:0}.progress-label{width:84rpx;color:#5f626d;text-align:right;font-size:20rpx}.task-meta{margin-top:7rpx;color:#8a8e99;font-size:19rpx;line-height:1.4}.source-button,.text-button{margin:0;padding:0;background:transparent;color:#5367d9;font-size:20rpx}.task-actions{justify-content:flex-end;margin-top:12rpx;padding-top:11rpx;border-top:1rpx solid #eceef2}.text-button{line-height:44rpx}.text-button.danger{color:#a04f4f}.completed-toggle{margin-top:34rpx;padding:21rpx 2rpx;border-top:1rpx solid #dfe2e8;color:#50535e;font-size:24rpx;font-weight:650}.completed-card{padding:20rpx;opacity:.76}.done-label{color:#287459;font-size:20rpx}

.search{border:2rpx solid #d9dde5;background:#fff;box-shadow:inset 5rpx 0 0 #aeb4c0}
.search:focus{border-color:#b8c0d0;box-shadow:inset 5rpx 0 0 #5367d9}

.diary-input-card{box-sizing:border-box;margin-top:24rpx;padding:25rpx;border:1rpx solid #dce1f6;border-radius:20rpx;background:linear-gradient(145deg,#fff 0,#f7f8ff 100%);box-shadow:0 10rpx 30rpx rgba(52,58,91,.045)}
.diary-sync{display:flex;align-items:flex-start;gap:10rpx;margin-top:14rpx;padding:13rpx 15rpx;border-radius:12rpx;color:#616571;font-size:20rpx;line-height:1.45}.diary-sync-dot{width:12rpx;height:12rpx;margin-top:7rpx;flex:0 0 auto;border-radius:50%;background:#9ca0aa}.diary-sync-syncing{background:#f4f6ff;color:#5367d9}.diary-sync-syncing .diary-sync-dot{background:#5367d9}.diary-sync-offline{background:#fff8eb;color:#946b2f}.diary-sync-offline .diary-sync-dot{background:#d08b3c}.diary-sync-error{background:#fff1f1;color:#a04f4f}.diary-sync-error .diary-sync-dot{background:#b45a5a}.diary-sync-ok{background:#eef8f2;color:#287459}.diary-sync-ok .diary-sync-dot{background:#287459}
.diary-input-head,.manual-input-fold{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}
.diary-input-title{color:#252731;font-size:27rpx;font-weight:720}
.diary-input-hint{margin-top:5rpx;color:#8b8f9a;font-size:19rpx;line-height:1.5}
.diary-input-count{color:#5367d9;font-size:18rpx;white-space:nowrap}
.diary-input{box-sizing:border-box;width:100%;min-height:150rpx;max-height:380rpx;margin-top:18rpx;padding:18rpx 20rpx;border:1rpx solid #dfe2ed;border-radius:14rpx;background:#fff;color:#30323b;font-size:24rpx;line-height:1.6}
.diary-input-submit{width:100%;height:70rpx;margin-top:14rpx;border-radius:13rpx;background:#5367d9;color:#fff;font-size:23rpx;font-weight:680;line-height:70rpx}
.manual-input-fold{margin-top:17rpx;padding-top:15rpx;border-top:1rpx solid #e7e9f2;color:#626778;font-size:21rpx}
.manual-input-action{color:#5367d9}
.manual-input-scroll{max-height:400rpx;margin-top:8rpx}
.manual-input-row{margin-top:10rpx;padding:15rpx 17rpx;border:1rpx solid #eceef5;border-radius:12rpx;background:#fff;color:#4e515c;font-size:22rpx;line-height:1.58;white-space:pre-wrap}
.manual-input-meta{display:block;margin-top:7rpx;color:#9a9da7;font-size:17rpx}
