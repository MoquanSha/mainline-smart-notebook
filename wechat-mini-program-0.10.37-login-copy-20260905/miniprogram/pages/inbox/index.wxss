.inbox-page{padding-top:36rpx}.all-button{width:auto;min-width:154rpx;margin:4rpx 0 0;padding:0 17rpx;font-size:22rpx}.review-guide,.section-line,.proposal-top,.proposal-actions,.evidence-row,.editor-actions,.time-editor,.step,.effect-row{display:flex;align-items:center;justify-content:space-between;gap:13rpx}.review-guide{margin-top:30rpx;padding:18rpx 20rpx;border:1rpx solid #e4e6ed;border-radius:15rpx;background:#fbfbfc}.guide-step{display:flex;align-items:center;gap:8rpx;color:#656975;font-size:19rpx;white-space:nowrap}.guide-step text{display:flex;align-items:center;justify-content:center;width:29rpx;height:29rpx;border-radius:50%;background:#edf1ff;color:#5367d9;font-size:17rpx;font-weight:700}.guide-line{height:1rpx;min-width:12rpx;flex:1;background:#dfe2e9}.section-line{justify-content:flex-start;margin:39rpx 0 16rpx}.section-title-inline{margin:0}.section-count{color:#858994;font-size:22rpx}.empty-state{padding:62rpx 26rpx;border:1rpx dashed #dfe2e9;border-radius:19rpx;background:#fbfbfc;text-align:center}.empty-mark{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;margin:0 auto;border-radius:50%;background:#eaf7f0;color:#25805f;font-size:27rpx;font-weight:800}.empty-title{margin-top:14rpx;font-size:27rpx;font-weight:680}.empty-copy{margin-top:10rpx;color:#9296a0;font-size:22rpx;line-height:1.55}.proposal-card{margin-bottom:17rpx;padding:22rpx;border:1rpx solid #e1e4eb;border-left:5rpx solid #5367d9;border-radius:19rpx;background:#fff;box-shadow:0 7rpx 24rpx rgba(23,24,32,.035)}.proposal-card.owner-border-ai{border-left-color:#7157b8}.proposal-card.owner-border-both{border-left-color:#287d78}.deferred-heading{margin-top:43rpx}.deferred-card{background:#fbfbfc}.proposal-top{justify-content:flex-start}.source-chip{padding:6rpx 11rpx;border-radius:8rpx;background:#edf1ff;color:#5367d9;font-size:19rpx;font-weight:680}.source-chip.source-wechat_mp{background:#eaf7f0;color:#25805f}.source-chip.source-codex{background:#f2effc;color:#