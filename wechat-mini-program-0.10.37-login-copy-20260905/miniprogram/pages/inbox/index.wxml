<view class="page inbox-page">
  <view class="page-header"><view class="header-copy"><view class="eyebrow">只处理 AI 无法替你决定的内容</view><view class="title">待确认</view></view><button wx:if="{{proposals.length}}" class="primary-button all-button" loading="{{applyingAll}}" bindtap="applyAll">全部采用</button></view>
  <view class="review-guide"><view class="guide-step"><text>1</text>看原话</view><view class="guide-line"></view><view class="guide-step"><text>2</text>看 AI 理解</view><view class="guide-line"></view><view class="guide-step"><text>3</text>决定是否采用</view></view>

  <view class="section-line"><view class="section-title section-title-inline">需要你确认</view><view class="section-count">{{proposals.length}}</view></view>
  <view wx:if="{{!loading && !proposals.length && !deferred.length}}" class="empty-state"><view class="empty-mark">✓</view><view class="empty-title">现在没有需要决定的内容</view><view class="empty-copy">明确的笔记已经自动整理；只有可能改变任务或日程的内容才会来到这里。</view></view>

  <view wx:for="{{proposals}}" wx:key="id" class="proposal-card owner-border-{{item.owner}}">
    <view class="proposal-top"><view class="source-chip source-{{item.sourceChannel}}">来自 {{item.sourceLabel}}</view><view class="type">{{item.typeLabel}}</view></view>
    <view wx:if="{{item.sourcePreview}}" class="source-quote"><view class="block-label">你说</view><view class="source-text">“{{item.sourcePreview}}”</view></view>
    <view class="ai-result"><view class="block-label ai-label">AI 整理为</view><view class="proposal-title">{{item.title}}</view><view wx:if="{{item.timeLabel}}" class="time">{{item.timeLabel}}</view><view class="proposal-detail">{{item.detail}}</view></view>
    <view wx:if="{{item.nextAction}}" class="next"><text>下一步</text>{{item.nextAction}}</view>
    <view wx:if="{{item.hasSteps}}" class="steps"><view wx:for="{{item.steps}}" wx:for-item="step" wx:key="title" class="step"><view class="step-number">{{index + 1}}</view><view>{{step.title}}</view></view></view>
    <view class="effect-row"><view class="effect-dot"></view><view>{{item.effectLabel}}</view></view>
    <view wx:if="{{item.confirmationQuestion || item.uncertaintyReason}}" class="uncertain"><view class="uncertain-label">需要你决定</view><view>{{item.confirmationQuestion || item.uncertaintyReason}}</view></view>
    <view class="evidence-row"><button class="link-button" data-id="{{item.id}}" bindtap="showSources">查看完整输入</button><button class="link-button" data-id="{{item.id}}" bindtap="startEdit">修改整理结果</button></view>
    <view class="proposal-actions"><button class="ghost-button" data-id="{{item.id}}" bindtap="remove">删除</button><button class="secondary-button proposal-action" data-id="{{item.id}}" bindtap="defer">稍后</button><button class="secondary-button proposal-action" data-id="{{item.id}}" bindtap="reject">不采用</button><button class="primary-button proposal-action" data-id="{{item.id}}" bindtap="apply">采用</button></view>
  </view>

  <view wx:if="{{deferred.length}}" class="section-line deferred-heading"><view class="section-title section-title-inline">稍后处理</view><view class="section-count">{{deferred.length}}</view></view>
<view wx:for="{{deferred}}" wx:key="id" class="proposal-card deferred-card owner-border-{{item.owner}}"><view class="proposal-top"><view class="source-chip source-{{item.sourceChannel}}">来自 {{item.sourceLabel}}</view><view class="type">{{item.typeLabel}}</view></view><view wx:if="{{item.sourcePreview}}" class="source-quote"><view class="block-label">你说</view><view class="source-text">“{{item.sourcePreview}}”</view></view><view class="ai-result"><view class="block-label ai-label">AI 整理为</view><view class="proposal-title">{{item.title}}</view><view class="proposal-detail">{{item.detail}}</view></view><view class="effect-row"><view class="effect-dot"></view><view>{{item.effectLabel}}</view></view><view class="evidence-row"><button class="link-button" data-id="{{item.id}}" bindtap="showSources">查看完整输入</button><button class="link-button" data-id="{{item.id}}" bindtap="startEdit">修改</button></view><view class="proposal-actions"><button class="ghost-button" data-id="{{item.id}}" bindtap="remove">删除</button><button class="secondary-button proposal-action wide-action" data-id="{{item.id}}" bindtap="restore">移回 AI 建议</button></view></view>

  <view wx:if="{{editingId}}" class="editor-mask"><view class="editor-panel"><view class="editor-title">修改整理结果</view><view class="field-label">标题</view><input class="field-input" value="{{editDraft.title}}" data-field="title" bindinput="editField" /><view class="field-label">说明</view><textarea class="field-textarea" value="{{editDraft.detail}}" data-field="detail" bindinput="editField" maxlength="1200"></textarea><view class="field-label">下一步</view><input class="field-input" value="{{editDraft.nextAction}}" data-field="nextAction" bindinput="editField" /><view class="time-editor"><input class="field-input" placeholder="日期 YYYY-MM-DD" value="{{editDraft.eventDate}}" data-field="eventDate" bindinput="editField"/><input class="field-input" placeholder="开始 HH:mm" value="{{editDraft.eventTime}}" data-field="eventTime" bindinput="editField"/><input class="field-input" placeholder="结束 HH:mm" value="{{editDraft.eventEndTime}}" data-field="eventEndTime" bindinput="editField"/></view><view class="editor-actions"><button class="secondary-button" bindtap="cancelEdit">取消</button><button class="primary-button" bindtap="saveEdit">保存修改</button></view></view></view>
</view>
