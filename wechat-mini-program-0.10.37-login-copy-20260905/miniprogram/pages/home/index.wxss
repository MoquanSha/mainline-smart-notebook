.header-sync:active{transform:scale(.96);opacity:.78}
@media(max-width:360px){.hero-actions{gap:7rpx}.header-sync{padding:0 11rpx;font-size:19rpx}}

/* Scheduled and completed records keep the existing todo visual language. */
.todo-compose-bottom{position:absolute;left:20rpx;right:15rpx;bottom:15rpx;display:flex;align-items:center;justify-content:space-between;gap:14rpx}
.todo-date-picker{display:flex;min-width:0;height:52rpx;padding:0 16rpx;align-items:center;border:1rpx solid #d9def2;border-radius:11rpx;background:#fff;color:#626a84;font-size:20rpx;line-height:52rpx}
.todo-compose-bottom .todo-add{position:static;right:auto;bottom:auto;flex:0 0 auto}
.scheduled-section{margin-top:28rpx;padding:20rpx;border:1rpx solid #e0e4f4;border-radius:18rpx;background:#fafbff}
.scheduled-head{display:flex;align-items:center;justify-content:space-between;color:#555d76;font-size:23rpx;font-weight:680}
.scheduled-count{padding:5rpx 10rpx;border-radius:9rpx;background:#e9edff;color:#5367d9;font-size:18rpx}
.scheduled-list{margin-top:12rpx}
.scheduled-row{display:grid;grid-template-columns:132rpx minmax(0,1fr);gap:14rpx;padding:13rpx 0;border-bottom:1rpx solid #e8eaf2}
.scheduled-row:last-child{border-bottom:0}
.scheduled-date{color:#6873ad;font-size:20rpx;font-weight:650}
.scheduled-title{overflow:hidden;color:#383c48;font-size:22rpx;text-overflow:ellipsis;white-space:nowrap}
.record-dates{display:block;margin-top:7rpx;color:#9a9da6;font-size:17rpx;line-height:1.45;text-decoration:none}
.completed-title{display:block;min-width:0;color:#747984;font-size:22rpx;line-height:1.4;text-decoration:line-through}
.completed-actions{display:flex;flex:0 0 auto;align-items:center;gap:12rpx}
.reopen-action{margin:0;padding:0;background:transparent;color:#5367d9;font-size:19rpx;line-height:34rpx}
.completion-search{margin-top:26rpx;padding-top:22rpx;border-top:1rpx solid #e5e7eb}
.completion-search-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:#5d626e;font-size:22rpx;font-weight:680}
.completion-all{display:flex;height:50rpx;margin:0;padding:0 14rpx;align-items:center;border:1rpx solid #dfe2e8;border-radius:10rpx;background:#f7f8fb;color:#666b78;font-size:19rpx;font-weight:680;line-height:50rpx}
.completion-all.is-active{border-color:#cfd5fb;background:#eef0ff;color:#5367d9}
.completion-calendar-toggle{display:flex;min-height:66rpx;margin-top:14rpx;padding:0 16rpx;align-items:center;justify-content:space-between;gap:14rpx;border:1rpx solid #e5e7eb;border-radius:14rpx;background:#fafafd;color:#5d626e;font-size:20rpx;font-weight:650}
.completion-calendar-toggle>view{display:flex;align-items:center;gap:9rpx}
.completion-calendar-toggle>view:last-child{color:#969aa4;font-size:18rpx;font-weight:500}
.completion-calendar-icon{color:#5367d9;font-size:25rpx}
.completion-calendar-caret{font-size:27rpx;transition:transform .16s ease}
.completion-calendar-toggle.is-open .completion-calendar-caret{transform:rotate(180deg)}
.completion-calendar{margin-top:14rpx;padding:16rpx;border:1rpx solid #e5e7eb;border-radius:14rpx;background:#fafafd}
.completion-calendar-nav{display:grid;grid-template-columns:58rpx minmax(0,1fr) 58rpx;align-items:center;gap:12rpx}
.completion-calendar-nav text{color:#4e535e;text-align:center;font-size:22rpx;font-weight:680}
.completion-calendar-nav button{width:54rpx;height:48rpx;margin:0;padding:0;border:1rpx solid #dfe2e8;border-radius:10rpx;background:#fff;color:#5367d9;font-size:32rpx;line-height:46rpx}
.completion-calendar-nav button[disabled]{border-color:#eceef3;background:#f2f3f5;color:#c6c9d0}
.completion-weekdays,.completion-calendar-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8rpx}
.completion-weekdays{margin-top:14rpx}
.completion-weekdays text{color:#9a9da6;text-align:center;font-size:17rpx}
.completion-calendar-grid{margin-top:8rpx}
.completion-day{display:flex;min-height:54rpx;align-items:center;justify-content:center;border:1rpx solid #dfe2e8;border-radius:10rpx;background:#fff;color:#4e535e;font-size:19rpx}
.completion-day.is-disabled{border-color:transparent;background:#eef0f2;color:#c3c6cd}
.completion-day.is-selected{border-color:#5367d9;background:#5367d9;color:#fff;font-weight:750}
.completion-day.is-empty{border-color:transparent;background:transparent}
.completion-filter-note{margin-top:13rpx;color:#5367d9;font-size:19rpx;font-weight:650}
.completion-results{height:720rpx;margin-top:13rpx;border:1rpx solid #e5e7eb;border-radius:14rpx;overflow:hidden;background:#fff;overscroll-behavior:contain}
.completion-result{display:grid;grid-template-columns:30rpx minmax(0,1fr);gap:12rpx;padding:18rpx;border-bottom:1rpx solid #eef0f3}
.completion-result:last-child{border-bottom:0}
.completion-result-copy{min-width:0}
.completion-name{display:block;color:#4e535e;font-size:22rpx;line-height:1.45}
.completion-note-toggle{display:flex;margin-top:10rpx;align-items:center;justify-content:space-between;color:#737986;font-size:18rpx;line-height:38rpx}
.completion-note-toggle text:last-child{color:#5367d9;font-weight:650}
.completion-notes{display:grid;margin-top:13rpx;gap:10rpx}
.completion-note{min-width:0;padding:13rpx 14rpx;border:1rpx solid #eceef2;border-radius:12rpx;background:#f7f8fa}
.completion-note-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:#9a9da6;font-size:17rpx;line-height:1.35}
.completion-note-content{display:block;margin-top:8rpx;color:#555b68;font-size:20rpx;line-height:1.55;white-space:pre-wrap;word-break:break-word}
.completion-note-gallery{display:flex;margin-top:10rpx;gap:9rpx;overflow-x:auto}
.completion-note-image{width:112rpx;height:112rpx;flex:0 0 112rpx;border:1rpx solid #e2e4e9;border-radius:10rpx;background:#eef0f3}
.completion-empty{margin-top:13rpx;padding:24rpx;border:1rpx dashed #d8dbe3;border-radius:14rpx;color:#9397a1;text-align:center;font-size:21rpx}

@media(max-width:360px){.scheduled-row{grid-template-columns:116rpx minmax(0,1fr)}.todo-date-picker{padding:0 12rpx;font-size:19rpx}.completion-search-head{align-items:flex-start;flex-direction:column}}

/* A pinned todo needs a stronger blue frame so it remains obvious at a glance. */
.todo-card.is-pinned{border-color:#8298e8;background:#e6edff}
.pin-corner.active{border-color:#667cda;background:#d6e1ff;color:#2948b5}

/* Historical photos stay visible before their note groups are expanded. */
.completion-photo-preview,.history-photo-preview{display:flex;margin-top:10rpx;gap:9rpx;overflow-x:auto}
.history-row{display:block}
.history-summary{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:11rpx;align-items:start}
.history-comments{color:#71788a}
.history-notes{margin-top:10rpx}
.comment-retry-hint{margin-top:12rpx;color:#97641c;font-size:22rpx;line-height:1.6}
