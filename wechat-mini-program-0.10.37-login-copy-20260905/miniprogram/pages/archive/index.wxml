<view class="page archive-page">
  <view class="archive-hero">
    <view><view class="eyebrow">记录与恢复</view><view class="title">数据档案</view></view>
    <view wx:if="{{status}}" class="archive-status">{{status}}</view>
  </view>
  <view class="archive-tabs">
    <view class="archive-tab {{activeSection === 'archive' ? 'is-active' : ''}}" data-section="archive" bindtap="switchSection">已归档 <text>{{entries.length}}</text></view>
    <view class="archive-tab {{activeSection === 'trash' ? 'is-active' : ''}}" data-section="trash" bindtap="switchSection">垃圾箱 <text>{{trashItems.length}}</text></view>
  </view>
  <view wx:if="{{loading}}" class="archive-loading">正在读取数据档案…</view>
  <block wx:elif="{{activeSection === 'archive'}}">
    <view class="archive-intro">这里保存手动归档和过去日期的灵光记录，不会混进今天。</view>
    <view wx:if="{{!entries.length}}" class="empty-state"><view class="empty-symbol">□</view><view class="empty-title">还没有归档内容</view><view class="empty-copy">在灵光一现中点击“归档”，内容会来到这里。</view></view>
    <view wx:for="{{entries}}" wx:key="id" class="archive-card">
      <view class="archive-meta"><text>{{item.sourceLabel}}</text><text>{{item.archivedLabel}}</text><text wx:if="{{item.itemCount}}">{{item.itemCount}} 项清单</text></view>
      <view class="archive-title">{{item.displayTitle}}</view>
      <view wx:if="{{item.displaySummary}}" class="archive-summary">{{item.displaySummary}}</view>
      <view class="archive-actions"><button class="restore-action" data-id="{{item.id}}" bindtap="restoreEntry">恢复到今天</button><button class="delete-action" data-id="{{item.id}}" bindtap="deleteEntry">移到垃圾箱</button></view>
    </view>
  </block>
  <block wx:else>
    <view class="archive-intro">误操作的内容会保留 15 天，到期后自动清除。</view>
    <view wx:if="{{!trashItems.length}}" class="empty-state"><view class="empty-symbol">✓</view><view class="empty-title">垃圾箱是空的</view><view class="empty-copy">被移除的待办和笔记会暂时保存在这里。</view></view>
    <view wx:for="{{trashItems}}" wx:key="id" class="archive-card trash-card">
      <view class="archive-meta"><text>{{item.typeLabel}}</text><text>{{item.trashedLabel}}</text><text class="expiry-label">{{item.expiryLabel}}</text></view>
      <view class="archive-title">{{item.displayTitle}}</view>
      <view class="archive-actions trash-actions"><button class="restore-action" data-id="{{item.id}}" data-entity-type="{{item.entityType}}" data-version="{{item.version}}" bindtap="restoreTrash">恢复</button></view>
    </view>
  </block>
</view>
