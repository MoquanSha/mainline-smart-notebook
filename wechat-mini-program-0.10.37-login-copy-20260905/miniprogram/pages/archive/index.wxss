.archive-page{padding-top:36rpx;padding-bottom:50rpx}.archive-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx}.archive-status{max-width:360rpx;padding-bottom:6rpx;color:#65707d;font-size:20rpx;text-align:right}.archive-tabs{display:flex;margin:28rpx 0 20rpx;padding:6rpx;border:1rpx solid #e3e5eb;border-radius:18rpx;background:#f5f6f8}.archive-tab{flex:1;padding:16rpx 20rpx;border-radius:13rpx;color:#747984;font-size:23rpx;text-align:center}.archive-tab text{margin-left:7rpx;color:#a2a6af}.archive-tab.is-active{background:#fff;color:#26304d;font-weight:700;box-shadow:0 3rpx 12rpx rgba(45,52,79,.08)}.archive-intro{margin:14rpx 0 24rpx;color:#838791;font-size:22rpx;line-height:1.55}.archive-loading{padding:80rpx 0;color:#8f939d;font-size:23rpx;text-align:center}.empty-state{padding:80rpx 24rpx;border:1rpx dashed #dfe2e9;border-radius:20rpx;background:#fbfbfc;text-align:center}.empty-symbol{color:#7c6755;font-size:34rpx}.empty-title{margin-top:10rpx;font-size:28rpx;font-weight:700}.empty-copy{margin-top:8rpx;color:#9296a0;font-size:22rpx}.archive-card{position:relative;margin-bottom:17rpx;padding:25rpx;border:1rpx solid #e2e4e9;border-radius:19rpx;background:#fff;box-shadow:inset 5rpx 0 0 #a49a8f}.trash-card{box-shadow:inset 5rpx 0 0 #c6a58b}.archive-meta{display:flex;flex-wrap:wrap;gap:10rpx 15rpx;color:#9699a2;font-size:19rpx}.expiry-label{color:#a16f4f}.archive-title{margin-top:13rpx;color:#25262d;font-size:28rpx;font-weight:720;line-height:1.42}.archive-summary{margin-top:9rpx;color:#666a74;font-size:22rpx;line-height:1.58}.archive-actions{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx;padding-top:14rpx;border-top:1rpx solid #eceef1}.trash-actions{justify-content:flex-end}.restore-action,.delete-action{min-width:150rpx;margin:0;padding:9rpx 16rpx;border-radius:12rpx;background:#f5f6fb;font-size:21rpx;line-height:1.6}.restore-action{color:#5367d9}.delete-action{color:#8e5b50;background:#fbf5f2}
