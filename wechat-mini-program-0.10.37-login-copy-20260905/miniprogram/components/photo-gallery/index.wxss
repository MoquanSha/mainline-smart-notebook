.gallery{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:10rpx}.photo{width:142rpx;height:142rpx}.image,.placeholder{box-sizing:border-box;display:block;width:100%;height:100%;border-radius:10rpx}.placeholder{display:flex;align-items:center;justify-content:center;margin:0;padding:12rpx;border:1rpx solid #dfe2e9;background:#f5f6fa;color:#6f7480;font-size:20rpx;line-height:1.5;white-space:normal}.placeholder::after{border:0}.compact .photo{width:112rpx;height:112rpx}.compact .placeholder{font-size:18rpx}
.photo{position:relative}.photo-status{position:absolute;left:6rpx;bottom:6rpx;padding:2rpx 8rpx;border-radius:6rpx;background:rgba(0,0,0,.6);color:#fff;font-size:18rpx;line-height:1.5}
